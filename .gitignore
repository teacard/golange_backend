# 環境變數，含資料庫密碼等敏感資訊
.env

# SQLite 資料庫檔案
*.db

# Go 編譯產出的執行檔
*.exe

# Air 熱重載的暫存目錄
tmp/

# Air 熱重載設定檔（本地自訂）
.air.toml

# Claude Code 本地設定、skills、creatures 等開發輔助資料
.claude/

# OpenSpec 變更追蹤文件（本地開發用，不進 git）
openspec/

# 設計稿、規格文件等本地文件目錄
docs/pencil/

# Swagger 自動產生的 API 文件（由 CI/CD 與本地 swag init 產生）
docs/docs.go
docs/swagger.json
docs/swagger.yaml
